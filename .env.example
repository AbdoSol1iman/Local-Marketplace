# Copy this file to .env and replace placeholder values before running.

# PostgreSQL
POSTGRES_DB=wafrnalak_db
DB_USERNAME=marketplace_user
DB_PASSWORD=replace_with_strong_password
DB_URL=jdbc:postgresql://db:5432/wafrnalak_db

# Application security
# Minimum recommended length: 32+ random characters.
JWT_SECRET=replace_with_long_random_secret

# Keep empty for production defaults.
# For local development only: set to dev
SPRING_PROFILES_ACTIVE=

# Future Firebase integration placeholders
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
