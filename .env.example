# Copy to .env and replace all placeholder values before running.

# PostgreSQL
POSTGRES_DB=wafrnalak_db
DB_URL=jdbc:postgresql://db:5432/wafrnalak_db
DB_USERNAME=marketplace_user
DB_PASSWORD=replace_with_strong_password

# App
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
SPRING_PROFILES_ACTIVE=prod

# Firebase (planned, not wired yet)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
